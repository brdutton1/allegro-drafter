<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build for one Revit year at a time:
      dotnet build -c Release -p:RevitVersion=2025
      dotnet build -c Release -p:RevitVersion=2026
    Output: bin\Release\R2025\ (or R2026). scripts\install.ps1 builds and installs both.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AllegroDrafter.Revit</RootNamespace>
    <AssemblyName>AllegroDrafter.Revit</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\R$(RevitVersion)\</OutputPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.10" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.10" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF without XAML compilation, so the add-in also builds on Linux CI. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AllegroDrafter.Core\AllegroDrafter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AllegroDrafter.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
